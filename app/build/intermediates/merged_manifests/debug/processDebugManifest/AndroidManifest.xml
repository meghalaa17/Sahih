<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sahih"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="com.sahih.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.sahih.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Sahih"
        android:theme="@android:style/Theme.Material.NoActionBar" >
        <activity
            android:name="com.sahih.MainActivity"
            android:exported="true"
            android:launchMode="singleTask" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
 "PayGuard" - a second, separately-labeled entry point into the
             same pre-checkout guard. Unlike "Cekdulu" (text), PayGuard
             always routes to Checkout regardless of content, for both text
             and image shares - e.g. a payment app or user explicitly wants
             the payment-validity check rather than the general verifier.
        -->
        <activity-alias
            android:name="com.sahih.PayGuardShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="PayGuard"
            android:targetActivity="com.sahih.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <!--
 "Cekdulu Checkout" - appears in the share sheet when sharing an
             image, e.g. a payment receipt, DuitNow QR, or transfer
             confirmation screenshot from a banking/e-wallet app. Routes
             straight to the Checkout (pre-checkout guard) screen.
        -->
        <activity-alias
            android:name="com.sahih.CekduluCheckoutShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Cekdulu Checkout"
            android:targetActivity="com.sahih.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <!--
 "Cekdulu" - appears in the native Android share sheet from
             WhatsApp, Instagram, TikTok, Telegram, etc. when sharing text -
             a link, a seller's number, a message. Forwards into MainActivity,
             which routes it to Verify (or Checkout if it looks like a
             payment, via routeForSharedText()).
        -->
        <activity-alias
            android:name="com.sahih.CekduluShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Cekdulu"
            android:targetActivity="com.sahih.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
             Background call-screening service. Requires the user to set Sahih
             as their call screening app in system settings (Android 10+).
        -->
        <service
            android:name="com.sahih.callshield.SahihCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE" >
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.sahih.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>